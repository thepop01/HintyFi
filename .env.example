# === Vercel Environment Variables Guide ===
# These are the ONLY variables you need to set in your Vercel project settings.
# Do NOT add any backend-specific variables like VITE_JWT_SECRET, VITE_ENCRYPTION_KEY, etc.

# --- Required ---
VITE_SUPABASE_URL="your_supabase_url_here"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
VITE_DISCORD_CLIENT_ID="your_discord_client_id_here"
VITE_DISCORD_REDIRECT_URI="https://hinty-fi.vercel.app/auth/callback" # Must match your Vercel domain
VITE_APP_URL="https://hinty-fi.vercel.app" # Must match your Vercel domain

# --- Optional ---
VITE_API_URL="your_deployed_backend_api_url_here" # The URL of your deployed backend server (if you have one)
GEMINI_API_KEY="your_gemini_api_key_here" # (WARNING: Insecure to expose on the frontend)


# === Local Development (.env file) Guide ===
# Use these values in your private .env file for local testing.

# VITE_DISCORD_REDIRECT_URI="http://localhost:3000/auth/callback"
# VITE_APP_URL="http://localhost:3000"
# VITE_API_URL="http://localhost:3001"
