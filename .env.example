# Vercel & Local Environment Variables Template
# Use this as a guide for setting up your environment variables in Vercel and for your local .env file.
# Do not commit sensitive keys to this file.

# Supabase Configuration
VITE_SUPABASE_URL="your_supabase_url_here"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Discord OAuth Configuration
VITE_DISCORD_CLIENT_ID="your_discord_client_id_here"
# For local development, use: http://localhost:3000/auth/callback
# For production (Vercel), use your production URL: https://your-domain.com/auth/callback
VITE_DISCORD_REDIRECT_URI="http://localhost:3000/auth/callback"

# Gemini API Key (Optional)
GEMINI_API_KEY="your_gemini_api_key_here"
